{
  "name": "knoedler-work-instruction",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knoedler-instructions",
      "database_id": "2f0a5a8d-ef61-436c-a053-3150ff85b7f7",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "knoedler-instruction-photos"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "knoedlervks@gmail.com",
    "CF_ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com",
    "CF_ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  }
}
